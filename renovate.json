{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [":label(Dependencies)", ":semanticCommitsDisabled"],
  "enabledManagers": ["nvm", "github-actions"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Other workflows come from upstream and are updated by the upstream sync. The gh-aw lock files are generated by gh aw compile.",
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "GitHub Actions in fork-only workflows: weekly, with a 7 day cooldown, like HA frontend",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/npmpublish.yml"],
      "enabled": true,
      "addLabels": ["GitHub Actions"],
      "schedule": ["before 8am on monday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Leave runner labels and action version inputs alone, like HA frontend",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner", "uses-with"],
      "enabled": false
    }
  ]
}
